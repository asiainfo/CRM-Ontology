@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://asiainfo.com/example-owl#> .

##################################
# 基础抽象类与通用语义（禁止变动）
##################################
ex:Entity a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "实体"@zh .
ex:Object a owl:Class ; rdfs:subClassOf ex:Entity ; rdfs:label "本体对象"@zh .
ex:Action a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "行动"@zh .
ex:Logic a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "决策/逻辑函数"@zh .
ex:hasPrimaryKey a owl:AnnotationProperty ; rdfs:label "主键属性"@zh ; rdfs:comment "在类级别声明该对象的主键数据属性"@zh .
ex:hasTitle a owl:AnnotationProperty ; rdfs:label "标题属性"@zh ; rdfs:comment "在类级别声明该对象的标题数据属性"@zh .
ex:bindAction a owl:ObjectProperty ; rdfs:label "本体对象关联行动"@zh ; rdfs:domain ex:Object ; rdfs:range ex:Action .
ex:bindLogic a owl:ObjectProperty ; rdfs:label "本体对象关联函数"@zh ; rdfs:domain ex:Object ; rdfs:range ex:Logic .
ex:custom_relation a owl:ObjectProperty ; rdfs:label "自定义对象与对象之间的关系"@zh .
ex:Parameter a owl:Class ; rdfs:label "函数参数"@zh .
ex:hasParameter a owl:ObjectProperty ; rdfs:label "有参数"@zh ; rdfs:domain ex:Logic ; rdfs:range ex:Parameter .
ex:paramName a owl:DatatypeProperty ; rdfs:label "参数名"@zh ; rdfs:domain ex:Parameter ; rdfs:range xsd:string .
ex:paramType a owl:DatatypeProperty ; rdfs:label "参数类型"@zh ; rdfs:domain ex:Parameter ; rdfs:range xsd:string .
ex:paramTypeNode a owl:ObjectProperty ; rdfs:label "参数类型节点"@zh ; rdfs:domain ex:Parameter .
ex:ListType a owl:Class ; rdfs:label "列表类型"@zh .
ex:DictType a owl:Class ; rdfs:label "字典类型"@zh .
ex:itemType a owl:DatatypeProperty ; rdfs:label "元素类型"@zh .
ex:keyType a owl:DatatypeProperty ; rdfs:label "键类型"@zh .
ex:valueType a owl:DatatypeProperty ; rdfs:label "值类型"@zh .
ex:isOptional a owl:DatatypeProperty ; rdfs:label "是否可选"@zh ; rdfs:domain ex:Parameter ; rdfs:range xsd:boolean .
ex:defaultValue a owl:DatatypeProperty ; rdfs:label "默认值"@zh ; rdfs:domain ex:Parameter ; rdfs:range xsd:string .
ex:ontologyName a owl:Class ; rdfs:label "本体名称"@zh .
ex:domainAttribute a owl:AnnotationProperty ; rdfs:label "域属性"@zh ; rdfs:comment "指定对象属性的域端使用哪个数据属性建立关联"@zh .
ex:rangeAttribute a owl:AnnotationProperty ; rdfs:label "值域属性"@zh ; rdfs:comment "指定对象属性的值域端使用哪个数据属性建立关联"@zh .
ex:hasMiddleObject a owl:ObjectProperty ; rdfs:label "中间对象"@zh ; rdfs:comment "用来描述多对多关系的情况下，两个对象所使用到的中间对象"@zh .
##################################
# 本体名称
##################################
ex:Product_marketing a ex:ontologyName ;
  rdfs:label "产品营销"@zh .

##################################
# 可用函数
##################################
ex:evaluate_campaign a ex:Logic ;
  rdfs:label "营销方案评估"@zh ;
  rdfs:comment """营销方案评估函数。

    职责：预测营销方案转化率并提供优化建议。

    输入：product_id(必填), channel_id(必填), discount_rate(默认0.0), holiday_season(可选), content_id(可选)

    输出：包含prediction、risk_analysis、suggestions的字典

    使用：evaluate_campaign("911856239313", "c_303639", discount_rate=0.2)

    算法：base_rate × customer_boost × promotion_boost × channel_fatigue × content_boost"""@zh ;
  ex:hasParameter [ a ex:Parameter ; ex:paramName "product_id" ; ex:paramType "xsd:string" ; ex:isOptional false ], [ a ex:Parameter ; ex:paramName "channel_id" ; ex:paramType "xsd:string" ; ex:isOptional false ], [ a ex:Parameter ; ex:paramName "discount_rate" ; ex:paramType "xsd:double" ; ex:isOptional true ], [ a ex:Parameter ; ex:paramName "holiday_season" ; ex:paramType "xsd:string" ; ex:isOptional true ], [ a ex:Parameter ; ex:paramName "content_id" ; ex:paramType "xsd:string" ; ex:isOptional true ] .

ex:match_product_to_users a ex:Logic ;
  rdfs:label "产品筛选用户群"@zh ;
  rdfs:comment """产品到人匹配函数。

    职责：根据产品特征筛选目标用户并创建营销活动。

    输入：product_id(必填), channel_id(必填), campaign_name(可选), video_prefer_min(默认0.0), game_prefer_min(默认0.0), arpu_min(默认0.0), flow_saturation_max(默认100.0), top_n(默认50)

    输出：包含campaign_id、total_matched、ranked_users的字典

    使用：match_product_to_users("517010168081", "10086_POPUP")

    算法：匹配得分×0.6 + 渠道转化率×0.4，自动创建Campaign"""@zh ;
  ex:hasParameter [ a ex:Parameter ; ex:paramName "product_id" ; ex:paramType "xsd:string" ; ex:isOptional false ], [ a ex:Parameter ; ex:paramName "channel_id" ; ex:paramType "xsd:string" ; ex:isOptional false ], [ a ex:Parameter ; ex:paramName "campaign_name" ; ex:paramType "xsd:string" ; ex:isOptional true ], [ a ex:Parameter ; ex:paramName "video_prefer_min" ; ex:paramType "xsd:double" ; ex:isOptional true ], [ a ex:Parameter ; ex:paramName "game_prefer_min" ; ex:paramType "xsd:double" ; ex:isOptional true ], [ a ex:Parameter ; ex:paramName "arpu_min" ; ex:paramType "xsd:double" ; ex:isOptional true ], [ a ex:Parameter ; ex:paramName "flow_saturation_max" ; ex:paramType "xsd:double" ; ex:isOptional true ], [ a ex:Parameter ; ex:paramName "top_n" ; ex:paramType "xsd:integer" ; ex:isOptional true ] .

ex:recommend_products a ex:Logic ;
  rdfs:label "用户推荐产品"@zh ;
  rdfs:comment """用户到产品推荐函数。

    职责：基于用户画像智能推荐产品并选择最佳渠道。

    输入：user_id(必填), channel_id(可选), top_n(默认3), product_weight(默认0.7), channel_weight(默认0.3)

    输出：包含selected_channel、user_insights、recommended_products、details的字典

    使用：recommend_products("U9347720574")

    算法：产品得分×权重 + 渠道得分×权重，多级排序"""@zh ;
  ex:hasParameter [ a ex:Parameter ; ex:paramName "user_id" ; ex:paramType "xsd:string" ; ex:isOptional false ], [ a ex:Parameter ; ex:paramName "channel_id" ; ex:paramType "xsd:string" ; ex:isOptional true ], [ a ex:Parameter ; ex:paramName "top_n" ; ex:paramType "xsd:integer" ; ex:isOptional true ], [ a ex:Parameter ; ex:paramName "product_weight" ; ex:paramType "xsd:double" ; ex:isOptional true ], [ a ex:Parameter ; ex:paramName "channel_weight" ; ex:paramType "xsd:double" ; ex:isOptional true ] .

##################################
# Action动作定义
##################################
ex:ExecuteTouchAction a ex:Action ;
  rdfs:label "执行触达动作"@zh ;
  rdfs:comment """@action_label: 执行10086弹窗触达
    批量推送10086弹窗消息给目标用户，支持自定义文案模板。
    调用: Campaign.ExecuteTouchAction(campaign_id="CAMP_001", product_id="xxx", channel_id="c_001", target_users=[{"user_id":"U001"}], content_id="CONTENT_001")
    必填: campaign_id, product_id, channel_id, target_users | 可选: content_id, message_template"""@zh ;
  ex:hasParameter [ a ex:Parameter ; ex:paramName "campaign_id" ; ex:paramType "xsd:string" ; ex:isOptional false ] ,
                    [ a ex:Parameter ; ex:paramName "product_id" ; ex:paramType "xsd:string" ; ex:isOptional false ] ,
                    [ a ex:Parameter ; ex:paramName "channel_id" ; ex:paramType "xsd:string" ; ex:isOptional false ] ,
                    [ a ex:Parameter ; ex:paramName "target_users" ; ex:paramType "list" ; ex:isOptional false ; ex:paramTypeNode [ a ex:ListType ] ] ,
                    [ a ex:Parameter ; ex:paramName "content_id" ; ex:paramType "xsd:string" ; ex:isOptional true ] ,
                    [ a ex:Parameter ; ex:paramName "message_template" ; ex:paramType "dict" ; ex:isOptional true ; ex:paramTypeNode [ a ex:DictType ] ] .

ex:Campaign ex:bindAction ex:ExecuteTouchAction .

ex:RecordContactHistory a ex:Action ;
  rdfs:label "回填渠道历史信息"@zh ;
  rdfs:comment """@action_label: 批量记录接触历史
    批量记录用户接触历史，写入ContactRecord对象。
    调用: ContactRecord.RecordContactHistory(campaign_id="xxx", product_id="xxx", channel_id="c_001", target_users=[{"user_id":"U001"}])
    必填: campaign_id, product_id, channel_id, target_users"""@zh ;
  ex:hasParameter [ a ex:Parameter ; ex:paramName "campaign_id" ; ex:paramType "xsd:string" ; ex:isOptional false ] ,
                    [ a ex:Parameter ; ex:paramName "product_id" ; ex:paramType "xsd:string" ; ex:isOptional false ] ,
                    [ a ex:Parameter ; ex:paramName "channel_id" ; ex:paramType "xsd:string" ; ex:isOptional false ] ,
                    [ a ex:Parameter ; ex:paramName "target_users" ; ex:paramType "list" ; ex:isOptional false ; ex:paramTypeNode [ a ex:ListType ] ] .

ex:ContactRecord ex:bindAction ex:RecordContactHistory .

ex:UpdateConversionStatus a ex:Action ;
  rdfs:label "更新用户办理状态"@zh ;
  rdfs:comment """@action_label: 更新用户办理状态
    更新用户的办理状态，同步更新Campaign和HistoricalMarketingData统计数据。
    调用: ContactRecord.UpdateConversionStatus(campaign_id="xxx", user_id="U001", is_subscribed=True)
    必填: campaign_id, user_id | 可选: is_subscribed(默认true)"""@zh ;
  ex:hasParameter [ a ex:Parameter ; ex:paramName "campaign_id" ; ex:paramType "xsd:string" ; ex:isOptional false ] ,
                    [ a ex:Parameter ; ex:paramName "user_id" ; ex:paramType "xsd:string" ; ex:isOptional false ] ,
                    [ a ex:Parameter ; ex:paramName "is_subscribed" ; ex:paramType "xsd:boolean" ; ex:isOptional true ] .

ex:ContactRecord ex:bindAction ex:UpdateConversionStatus .

##################################
# 逻辑函数关联定义 (bindLogic)
##################################
ex:UserProfile ex:bindLogic ex:recommend_products .
ex:ProductCatalog ex:bindLogic ex:match_product_to_users .
ex:UserInfo ex:bindLogic ex:recommend_products .
ex:ContactRecord ex:bindLogic ex:evaluate_campaign .
ex:ProductStrategy ex:bindLogic ex:recommend_products .
ex:HistoricalMarketingData ex:bindLogic ex:evaluate_campaign .
ex:ProductCatalog ex:bindLogic ex:evaluate_campaign .
ex:ProductCatalog ex:bindLogic ex:recommend_products .
ex:ChannelInfo ex:bindLogic ex:match_product_to_users .
ex:UserInfo ex:bindLogic ex:match_product_to_users .
ex:ProductStrategy ex:bindLogic ex:match_product_to_users .
ex:UserProfile ex:bindLogic ex:match_product_to_users .
ex:ContactRecord ex:bindLogic ex:match_product_to_users .
ex:ProductStrategy ex:bindLogic ex:evaluate_campaign .

##################################
# 对象定义(必须继承ex:Object)
##################################
ex:Campaign a owl:Class ;
  rdfs:subClassOf ex:Object ;
  rdfs:label "营销活动"@zh ;
  rdfs:label "Campaign"@en ;
  ex:hasPrimaryKey ex:活动ID ;
  ex:hasTitle ex:活动名称 ;
  rdfs:comment """    用途：记录营销活动的基本信息和配置，用于：
    1. 场景2：产品到人 - 创建和管理营销活动（CreateMarketingCampaign动作）
    2. 场景3：方案转化率预测 - 提供活动配置信息用于效果预测"""@zh .

ex:ChannelInfo a owl:Class ;
  rdfs:subClassOf ex:Object ;
  rdfs:label "渠道"@zh ;
  rdfs:label "ChannelInfo"@en ;
  ex:hasPrimaryKey ex:渠道ID ;
  ex:hasTitle ex:渠道名 ;
  rdfs:comment "渠道配置信息对象 - 渠道静态属性和业务规则"@zh .

ex:ContactRecord a owl:Class ;
  rdfs:subClassOf ex:Object ;
  rdfs:label "渠道记录"@zh ;
  rdfs:label "ContactRecord"@en ;
  ex:hasPrimaryKey ex:ID ;
  rdfs:comment "接触记录对象 - 用户营销接触明细数据"@zh .

ex:HistoricalMarketingData a owl:Class ;
  rdfs:subClassOf ex:Object ;
  rdfs:label "营销记录"@zh ;
  rdfs:label "HistoricalMarketingData"@en ;
  ex:hasPrimaryKey ex:ID ;
  rdfs:comment """历史营销数据 
    用途：存储历史营销活动的执行记录和转化结果，用于：
    1. 场景1：智能渠道决策 - 分析用户在各渠道的历史转化表现
    2. 场景3：方案转化率预测 - 提供历史基准转化率数据
    关键字段：策略ID、产品ID、渠道ID、目标用户数、触达数、办理数、转化率"""@zh .

ex:MarketingContent a owl:Class ;
  rdfs:subClassOf ex:Object ;
  rdfs:label "营销文案"@zh ;
  rdfs:label "MarketingContent"@en ;
  ex:hasPrimaryKey ex:ID ;
  rdfs:comment """    用途：存储营销文案模板和内容，用于：
    1. 场景2：产品到人 - ExecuteTouchAction动作中的个性化文案生成
    2. 不同渠道的营销内容管理（短信、APP弹窗、推送通知等）"""@zh .

ex:ProductCatalog a owl:Class ;
  rdfs:subClassOf ex:Object ;
  rdfs:label "产品"@zh ;
  rdfs:label "ProductCatalog"@en ;
  rdfs:comment "产品目录对象 - 产品静态属性和资源配置"@zh .

ex:ProductStrategy a owl:Class ;
  rdfs:subClassOf ex:Object ;
  rdfs:label "产品画像"@zh ;
  rdfs:label "ProductStrategy"@en ;
  ex:hasPrimaryKey ex:自增主键 ;
  rdfs:comment "产品策略对象 - 营销策略和商务规则"@zh .

ex:UserBehavior a owl:Class ;
  rdfs:subClassOf ex:Object ;
  rdfs:label "用户行为"@zh ;
  rdfs:label "UserBehavior"@en ;
  ex:hasPrimaryKey ex:自增主键 ;
  rdfs:comment "用户行为对象 - 浏览、查询、营销接触行为"@zh .

ex:UserInfo a owl:Class ;
  rdfs:subClassOf ex:Object ;
  rdfs:label "用户"@zh ;
  rdfs:label "UserInfo"@en ;
  ex:hasPrimaryKey ex:自增主键 ;
  rdfs:comment ""@zh .

ex:UserProfile a owl:Class ;
  rdfs:subClassOf ex:Object ;
  rdfs:label "用户画像"@zh ;
  rdfs:label "UserProfile"@en ;
  ex:hasPrimaryKey ex:自增主键 ;
  rdfs:comment "用户画像对象 - 消费价值与资源使用特征"@zh .

##################################
# 数据属性定义
# 每个对象的属性里，只能拥有一个primarykey
##################################
ex:AB测试组 a owl:DatatypeProperty ;
  rdfs:domain ex:MarketingContent ;
  rdfs:range xsd:string ;
  rdfs:comment "A/B测试组，如：A组、B组、对照组"@zh ;
  rdfs:label "AB测试组"@zh .

ex:按钮链接 a owl:DatatypeProperty ;
  rdfs:domain ex:MarketingContent ;
  rdfs:range xsd:string ;
  rdfs:comment "行动按钮链接"@zh ;
  rdfs:label "按钮链接"@zh .

ex:按钮文字 a owl:DatatypeProperty ;
  rdfs:domain ex:MarketingContent ;
  rdfs:range xsd:string ;
  rdfs:comment "行动按钮文本，如：立即办理、了解详情"@zh ;
  rdfs:label "按钮文字"@zh .

ex:实际转化数 a owl:DatatypeProperty ;
  rdfs:domain ex:HistoricalMarketingData ;
  rdfs:range xsd:int ;
  rdfs:comment "实际办理数"@zh ;
  rdfs:label "实际转化数"@zh .

ex:实际触达数 a owl:DatatypeProperty ;
  rdfs:domain ex:HistoricalMarketingData ;
  rdfs:range xsd:int ;
  rdfs:comment "实际触达数"@zh ;
  rdfs:label "实际触达数"@zh .

ex:适用人群 a owl:DatatypeProperty ;
  rdfs:domain ex:MarketingContent ;
  rdfs:range xsd:string ;
  rdfs:comment "适用客群标签，多个用逗号分隔"@zh ;
  rdfs:label "适用人群"@zh .

ex:适用产品 a owl:DatatypeProperty ;
  rdfs:domain ex:MarketingContent ;
  rdfs:range xsd:string ;
  rdfs:comment "适用产品类型，多个用逗号分隔"@zh ;
  rdfs:label "适用产品"@zh .

ex:审批状态 a owl:DatatypeProperty ;
  rdfs:domain ex:MarketingContent ;
  rdfs:range xsd:string ;
  rdfs:comment "审核状态：PENDING-待审核，APPROVED-已通过，REJECTED-已拒绝"@zh ;
  rdfs:label "审批状态"@zh .

ex:审批时间 a owl:DatatypeProperty ;
  rdfs:domain ex:MarketingContent ;
  rdfs:range xsd:date ;
  rdfs:comment "审核时间"@zh ;
  rdfs:label "审批时间"@zh .

ex:审批人 a owl:DatatypeProperty ;
  rdfs:domain ex:MarketingContent ;
  rdfs:range xsd:string ;
  rdfs:comment "审核人"@zh ;
  rdfs:label "审批人"@zh .

ex:平均匹配分 a owl:DatatypeProperty ;
  rdfs:domain ex:HistoricalMarketingData ;
  rdfs:range xsd:decimal ;
  rdfs:comment "平均匹配分数"@zh ;
  rdfs:label "平均匹配分"@zh .

ex:正文 a owl:DatatypeProperty ;
  rdfs:domain ex:MarketingContent ;
  rdfs:range xsd:string ;
  rdfs:comment "文案正文"@zh ;
  rdfs:label "正文"@zh .

ex:预算金额 a owl:DatatypeProperty ;
  rdfs:domain ex:Campaign ;
  rdfs:range xsd:decimal ;
  rdfs:comment "预算金额，单位：元"@zh ;
  rdfs:label "预算金额"@zh .

ex:通话时长 a owl:DatatypeProperty ;
  rdfs:domain ex:ContactRecord ;
  rdfs:range xsd:int ;
  rdfs:comment "通话时长（秒）"@zh ;
  rdfs:label "通话时长"@zh .

ex:活动描述 a owl:DatatypeProperty ;
  rdfs:domain ex:Campaign ;
  rdfs:range xsd:string ;
  rdfs:comment "活动描述"@zh ;
  rdfs:label "活动描述"@zh .

ex:活动ID a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( ex:Campaign ex:HistoricalMarketingData ex:ContactRecord ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "策略ID"@zh ;
  rdfs:label "活动ID"@zh .

ex:活动名称 a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( ex:Campaign ex:HistoricalMarketingData ex:ContactRecord ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "策略名称"@zh ;
  rdfs:label "活动名称"@zh .

ex:活动来源 a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( ex:Campaign ex:ContactRecord ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "策略的来源"@zh ;
  rdfs:label "活动来源"@zh .

ex:活动状态 a owl:DatatypeProperty ;
  rdfs:domain ex:Campaign ;
  rdfs:range xsd:string ;
  rdfs:comment "活动状态：CREATED-已创建，RUNNING-进行中，PAUSED-已暂停，COMPLETED-已完成，CANCELLED-已取消"@zh ;
  rdfs:label "活动状态"@zh .

ex:活动类型 a owl:DatatypeProperty ;
  rdfs:domain ex:Campaign ;
  rdfs:range xsd:string ;
  rdfs:comment "活动类型，如：新品推广、促销活动、会员专享等"@zh ;
  rdfs:label "活动类型"@zh .

ex:渠道ID a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( ex:Campaign ex:HistoricalMarketingData ex:ContactRecord ex:ChannelInfo ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "渠道ID，主键"@zh ;
  rdfs:label "渠道ID"@zh .

ex:渠道名称 a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( ex:HistoricalMarketingData ex:Campaign ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "渠道名称"@zh ;
  rdfs:label "渠道名称"@zh .

ex:渠道统计 a owl:DatatypeProperty ;
  rdfs:domain ex:ChannelInfo ;
  rdfs:range xsd:string ;
  rdfs:comment "当月渠道触达统计，JSON格式"@zh ;
  rdfs:label "渠道统计"@zh .

ex:近3日统计 a owl:DatatypeProperty ;
  rdfs:domain ex:ChannelInfo ;
  rdfs:range xsd:string ;
  rdfs:comment "近三月渠道触达次数均值统计，JSON格式"@zh ;
  rdfs:label "近3日统计"@zh .

ex:渠道类型 a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( ex:MarketingContent ex:ChannelInfo ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "渠道类型：SMS-短信，APP-APP推送，10086_POPUP-10086弹窗，OUTBOUND-外呼等"@zh ;
  rdfs:label "渠道类型"@zh .

ex:点击数 a owl:DatatypeProperty ;
  rdfs:domain ex:MarketingContent ;
  rdfs:range xsd:int ;
  rdfs:comment "点击次数"@zh ;
  rdfs:label "点击数"@zh .

ex:点击率 a owl:DatatypeProperty ;
  rdfs:domain ex:MarketingContent ;
  rdfs:range xsd:decimal ;
  rdfs:comment "点击率，点击次数/展示次数"@zh ;
  rdfs:label "点击率"@zh .

ex:内容ID a owl:DatatypeProperty ;
  rdfs:domain ex:Campaign ;
  rdfs:range xsd:string ;
  rdfs:comment "营销文案ID，关联营销文案表"@zh ;
  rdfs:label "内容ID"@zh .

